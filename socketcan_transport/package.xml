<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>socketcan_transport</name>
  <version>0.0.1</version>
  <description>SocketCAN transport plugin for ros2_control</description>
  <maintainer email="nnaraindev@gmail.com">Natesh Narain</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>transport_interface</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <transport_interface plugin="${prefix}/plugins.xml"/>
  </export>
</package>
