<?xml version="1.0"?>
<robot name="transport_demo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Physical links -->
  <link name="base_link"/>
  <link name="left_wheel"/>
  <link name="right_wheel"/>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================
       ONE transport declaration for the whole bus — shared by all
       consumers below. Switch the plugin to swap the bus backend:
         - transport_interface/MockCanTransport   (no hardware, loopback)
         - socketcan_transport/SocketCanTransport (real CAN, needs can0)
       ============================================================ -->
  <ros2_control name="can0" type="transport">
    <plugin>transport_interface/MockCanTransport</plugin>
    <param name="loopback">true</param>
  </ros2_control>

  <!-- ============================================================
       Consumers reference the transport BY NAME. Both motors share
       the single can0 instance — the bus is declared once, never
       duplicated inside a component block.
       ============================================================ -->
  <ros2_control name="left_motor" type="actuator">
    <hardware>
      <plugin>ros2_control_transport_demo/TransportDemoActuator</plugin>
      <param name="transport">can0</param>
      <param name="arbitration_id">0x201</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <ros2_control name="right_motor" type="actuator">
    <hardware>
      <plugin>ros2_control_transport_demo/TransportDemoActuator</plugin>
      <param name="transport">can0</param>
      <param name="arbitration_id">0x202</param>
    </hardware>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
